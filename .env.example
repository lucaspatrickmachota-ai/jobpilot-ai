# Local development defaults only. Replace values before any non-local deployment.
APP_ENV=development
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]
MAX_RESUME_SIZE_MB=10
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=1536
MATCH_WEIGHT_SKILLS=0.50
MATCH_WEIGHT_EXPERIENCE=0.30
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_LANGUAGES=0.10
